# Configuração local opcional do Postgres.
# SQLite é o padrão e não precisa deste arquivo.

POSTGRES_DB=replaykit
POSTGRES_USER=replaykit
POSTGRES_PASSWORD=replaykit
POSTGRES_PORT=5432

DATABASE_URL=postgresql://replaykit:replaykit@localhost:5432/replaykit
TEST_DATABASE_URL=postgresql://replaykit:replaykit@localhost:5432/replaykit
